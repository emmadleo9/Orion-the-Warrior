# Orion The Warrior — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Instagram (Meta) integration — Social Hub
# ---------------------------------------------------------------------------
# Create an app at https://developers.facebook.com/apps/ and add the
# "Instagram Business Login" product. Use the Instagram App ID / App Secret
# (NOT the Facebook App ID) shown on the app's Instagram > API setup page.
ORION_INSTAGRAM_APP_ID=
ORION_INSTAGRAM_APP_SECRET=

# Must match a callback URL registered in the Meta app EXACTLY, character for
# character, including scheme, host, port and trailing path. The default below
# matches Orion's built-in launcher (127.0.0.1:8000).
ORION_INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Graph API version enabled for your Meta app.
ORION_INSTAGRAM_API_VERSION=v25.0

# ---------------------------------------------------------------------------
# Optional: local model / storage overrides
# ---------------------------------------------------------------------------
# ORION_OLLAMA_URL=http://127.0.0.1:11434
# ORION_OLLAMA_MODEL=qwen2.5:3b
# ORION_ZARA_MODEL=qwen2.5:3b
# ORION_OLLAMA_CONTEXT=4096
# ORION_OLLAMA_MAX_TOKENS=256
# ORION_ARCHER_MODEL=stabilityai/sd-turbo
# ORION_ARCHER_STEPS=1
# ORION_MEMORY_PATH=orion_app/data/conversations.sqlite3
# ORION_DEVICES_DB=
# ORION_GENERATED_DIR=
# ORION_LAUNCHER_LOG=
