# Orion The Warrior — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Instagram (Meta) integration — Social Hub
# ---------------------------------------------------------------------------
# Create an app at https://developers.facebook.com/apps/ and add the
# "Instagram Business Login" product. Use the Instagram App ID / App Secret
# (NOT the Facebook App ID) shown on the app's Instagram > API setup page.
ORION_INSTAGRAM_APP_ID=
ORION_INSTAGRAM_APP_SECRET=

# Must match a callback URL registered in the Meta app EXACTLY, character for
# character, including scheme, host, port and trailing path. The default below
# matches Orion's built-in launcher (127.0.0.1:8000).
ORION_INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Graph API version enabled for your Meta app.
ORION_INSTAGRAM_API_VERSION=v25.0

# ---------------------------------------------------------------------------
# Telegram integration — Social Hub
# ---------------------------------------------------------------------------
# Get an api_id/api_hash pair from https://my.telegram.org > API development
# tools. Orion falls back to the public Telegram Desktop credentials when these
# are left unset, but a personal pair is recommended for a real account.
ORION_TELEGRAM_API_ID=
ORION_TELEGRAM_API_HASH=

# Live MTProto handshakes are opt-in. Leave unset (0) for instant local/demo
# mode; set to 1 to let Orion actually connect to Telegram. On restricted
# networks (e.g. Pakistan) the first handshake can block, so it is off by default.
ORION_TELEGRAM_LIVE=0

# Session file name and where downloaded media is cached (optional).
# ORION_TELEGRAM_SESSION=orion_telegram
# ORION_TELEGRAM_MEDIA_PATH=

# Weekly hidden-proxy refresh schedule (default: Sunday 03:00 Asia/Karachi).
# ORION_TELEGRAM_REFRESH_DAY=sun
# ORION_TELEGRAM_REFRESH_HOUR=3
# ORION_TELEGRAM_TIMEZONE=Asia/Karachi

# ---------------------------------------------------------------------------
# Optional: local model / storage overrides
# ---------------------------------------------------------------------------
# ORION_OLLAMA_URL=http://127.0.0.1:11434
# ORION_OLLAMA_MODEL=qwen2.5:3b
# ORION_ZARA_MODEL=qwen2.5:3b
# ORION_OLLAMA_CONTEXT=4096
# ORION_OLLAMA_MAX_TOKENS=256
# ORION_ARCHER_MODEL=stabilityai/sd-turbo
# ORION_ARCHER_STEPS=1
# ORION_MEMORY_PATH=orion_app/data/conversations.sqlite3
# ORION_DEVICES_DB=
# ORION_GENERATED_DIR=
# ORION_LAUNCHER_LOG=
